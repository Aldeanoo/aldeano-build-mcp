# Minecraft Server Connection
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=MCPBot
MC_VERSION=1.20.4
MC_AUTH=offline

# Bot Connection & Reconnect Settings
MC_CONNECT_TIMEOUT=30000
MC_RECONNECT=true
MC_RECONNECT_ATTEMPTS=5

# Logging
LOG_LEVEL=info

# Build engine
BUILD_MODE=physical
BUILD_VERIFY=true
BUILD_AUTO_REPAIR=true
BUILD_MAX_BLOCKS=10000
BUILD_BATCH_SIZE=100
BUILD_CONCURRENCY=4
BUILD_RETRY_COUNT=2
BUILD_TIMEOUT_MS=30000
BUILD_MAX_REPAIR_PASSES=3
BUILD_MAX_DIMENSION=256
BUILD_MAX_QUEUE=20000
BUILD_FAST_MODE_ENABLED=false
BUILD_FAST_COMMAND_INTERVAL_MS=20
BUILD_CINEMATIC_DELAY_MS=100
BUILD_PREFLIGHT_MAX_BLOCKS=1000000
BUILD_PREFLIGHT_NAVIGATION_TIMEOUT_MS=45000
BUILD_TELEPORT_ENABLED=true
BUILD_VERIFICATION_SECTOR_SIZE=32
WORLD_MAX_SCAN_BLOCKS=65536
