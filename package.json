{
  "name": "aldeano-build-mcp",
  "version": "0.1.0",
  "description": "An MCP server and automation framework that allows AI agents to interact with, understand and build inside Minecraft.",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "aldeano-build-mcp": "dist/main.js"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "nodeArguments": [
      "--import=tsx"
    ]
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:mcp": "tsx src/main.ts",
    "dev:shell": "tsx src/dev/dev-shell.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "mc:setup": "tsx scripts/minecraft/setup-server.ts",
    "mc:start": "tsx scripts/minecraft/start-server.ts",
    "mc:reset": "tsx scripts/minecraft/reset-world.ts",
    "doctor": "tsx src/dev/doctor.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/main.js",
    "test": "ava tests/unit/**/*.test.ts",
    "test:unit": "ava tests/unit/**/*.test.ts",
    "test:integration": "ava tests/integration/**/*.ts",
    "test:minecraft": "tsx scripts/run-smoke-test.ts",
    "lint": "eslint \"{src,tests,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,tests,scripts}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "minecraft-data": "^3.105.0",
    "mineflayer": "^4.35.0",
    "mineflayer-pathfinder": "^2.4.2",
    "vec3": "^0.1.8",
    "yargs": "^18.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ava/typescript": "^6.0.0",
    "@types/node": "^25.2.3",
    "@types/sinon": "^21.0.0",
    "@types/vec3": "^0.1.4",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.56.1",
    "ava": "^6.4.1",
    "eslint": "^9.39.2",
    "eslint-plugin-ava": "^15.1.0",
    "globals": "^17.3.0",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}